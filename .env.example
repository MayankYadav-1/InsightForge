# Local Ollama model (no paid API key; 'ollama' is an unused compatibility value).
LLM_API_KEY=ollama
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen3:4b
LLM_TIMEOUT_SECONDS=120
OLLAMA_KEEP_ALIVE=10m

# Local app configuration
INSIGHTFORGE_DATA_DIR=./data
INSIGHTFORGE_MAX_UPLOAD_MB=25
INSIGHTFORGE_MAX_ROWS=250000
INSIGHTFORGE_MAX_COLUMNS=250
# Optional PostgreSQL catalog. Docker Compose enables this by default.
DATABASE_URL=
